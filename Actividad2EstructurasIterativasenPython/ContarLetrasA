"""
Programa: Contar letras 'a' en una palabra
Descripción: Solicita una palabra al usuario y cuenta cuántas veces 
aparece la letra 'a' utilizando un ciclo for y un contador.
"""

print("--- Contar Letras 'a' ---")

# 1. Solicitar la palabra al usuario
palabra = input("Ingresa una palabra: ")

# Inicializar el contador
contador = 0

# 2. Recorrer cada letra con un ciclo for
for letra in palabra:
  if letra == 'a':
    contador += 1

# 3. Mostrar el resultado
print(f"\nLa letra 'a' aparece {contador} veces en la palabra.")