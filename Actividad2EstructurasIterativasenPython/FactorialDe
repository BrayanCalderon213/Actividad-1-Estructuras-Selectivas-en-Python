"""
Programa: Calculadora de Factorial
Descripción: Calcula el factorial de un número entero ingresado por el usuario 
utilizando un ciclo for, considerando que 0! = 1 e incluye manejo de errores.
"""

print("--- Calculadora de Factorial ---")

# 1. Solicitar el número al usuario
try:
    n = int(input("Ingresa un número entero no negativo: "))

    if n < 0:
        print("\nError: El factorial no está definido para números negativos.")
    else:
        resultado = 1

        # 2. Ciclo for para multiplicar los números desde 1 hasta n
        for i in range(1, n + 1):
            resultado *= i

        # 3. Mostrar el resultado final
        print(f"\nResultado: El factorial de {n} es {resultado}")

except ValueError:
    print("\nError: Debes ingresar un número entero válido.")