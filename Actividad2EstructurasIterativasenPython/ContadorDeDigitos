"""
Programa: Contador de Dígitos
Descripción: Solicita un número entero al usuario y determina cuántos 
dígitos tiene convirtiéndolo a cadena y usando la función len().
"""

print("--- Contador de Dígitos ---")

# 1. Solicitar el número al usuario
numero = input("Ingresa un número entero: ")

# 2. Calcular la cantidad de dígitos (ignorando el signo negativo si lo tiene)
digitos = len(numero.replace("-", ""))

# 3. Mostrar el resultado
print(f"\nEl número tiene {digitos} dígitos.")