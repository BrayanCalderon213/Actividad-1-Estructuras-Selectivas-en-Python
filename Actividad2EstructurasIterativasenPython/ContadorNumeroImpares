"""
Programa: Contador de números impares
Descripción: Solicita un número entero positivo y muestra todos los 
números impares desde 1 hasta ese número utilizando un bucle do-while simulado.
"""

print("--- Contador de Números Impares ---")

# 1. Solicitar el número al usuario
limite = int(input("Ingresa un número entero positivo: "))

# Inicializar el contador
actual = 1

# 2. Simular un ciclo do-while
while True:
  # Imprimir el número si es impar
  if actual % 2 != 0:
    print(actual)

  # Incrementar el contador
  actual += 1

  # Condición para romper el ciclo (equivalente al while del do-while)
  if actual > limite:
    break