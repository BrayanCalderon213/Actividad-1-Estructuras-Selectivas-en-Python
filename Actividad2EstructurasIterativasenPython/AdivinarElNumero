"""
Programa: Adivinar el número
Descripción: Genera un número aleatorio entre 1 y 100 y le permite al usuario 
adivinarlo, dando pistas de si su suposición es muy alta o muy baja mediante un ciclo while.
"""

import random

print("--- Juego: Adivina el Número ---")

# 1. Generar el número aleatorio entre 1 y 100
numero_secreto = random.randint(1, 100)
adivinado = False

# 2. Ciclo while que se repite hasta que el usuario acierte
while not adivinado:
  try:
    intento = int(input("Ingresa tu suposición (1 - 100): "))

    if intento < numero_secreto:
      print("Demasiado bajo. Intenta de nuevo.\n")
    elif intento > numero_secreto:
      print("Demasiado alto. Intenta de nuevo.\n")
    else:
      print(f"\n¡Felicidades! Adivinaste el número {numero_secreto}.")
      adivinado = True
  except ValueError:
    print("Por favor, ingresa un número entero válido.\n")