"""
Programa: Números divisibles por 3 y 5
Descripción: Imprime todos los números entre 1 y 100 que son 
divisibles tanto por 3 como por 5 utilizando un ciclo for y el operador módulo.
"""

print("--- Números divisibles por 3 y 5 (1 al 100) ---")

# Recorrer los números del 1 al 100
for i in range(1, 101):
  # Verificar si es divisible por 3 y por 5 al mismo tiempo
  if i % 3 == 0 and i % 5 == 0:
    print(i)