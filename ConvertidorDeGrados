"""
Programa: Convertidor de Temperatura
Descripción: Convierte una temperatura ingresada en grados Celsius a Fahrenheit 
o Kelvin según la elección del usuario, utilizando un menú y una estructura match-case.
"""

print("--- Convertidor de Temperatura ---")

# 1. Solicitar la temperatura en Celsius
celsius = float(input("Ingresa la temperatura en grados Celsius: "))

# 2. Mostrar un menú de opciones
print("\n¿A qué unidad deseas convertir?")
print("1. Fahrenheit (F)")
print("2. Kelvin (K)")

opcion = int(input("Ingresa el número de tu opción (1 o 2): "))

# 3. Usar match-case para realizar la conversión
match opcion:
    case 1:
        fahrenheit = (celsius * 9 / 5) + 32
        print(f"\nResultado: {celsius:.2f}°C equivalen a {fahrenheit:.2f}°F")
    case 2:
        kelvin = celsius + 273.15
        print(f"\nResultado: {celsius:.2f}°C equivalen a {kelvin:.2f}K")
    case _:
        print("\nError: Opción no válida. Debes elegir 1 o 2.")
        